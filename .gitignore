# Godot 4
.godot/
*.translation
export/
*.tmp

# AI-generated / third-party audio: license not cleared for the public repo yet (see assets/audio/README.md)
assets/audio/*.wav
assets/audio/*.wav.import
assets/audio/*.ogg
assets/audio/*.ogg.import
assets/audio/manifest.json
assets/audio/_raw/
assets/audio/_shortlist/
assets/audio/_pick/
assets/audio/_voice_raw/
assets/audio/_far_dsp/
# Ready or Not import (tools/audio/import_ron.py): its report, transcripts and the backups of replaced files
assets/audio/_import/
assets/audio/_backup/
# character models: only the .glb files are kept; the editor's import files and the textures it extracts are rebuilt on import
assets/characters/*.import
assets/characters/*.jpg
assets/characters/*.png
assets/audio/_voice_ref/
assets/audio/_voice_gen/
__pycache__/

# model check pictures (tools/models/check_models.gd)
tools/models/_out/
# Godot import files of model sets (assets/characters/<set>/, assets/gear/<set>/): rebuilt on import
assets/characters/*/*.import
assets/gear/**/*.import
# ...and the textures the editor extracts from them (the source pictures stay tracked)
assets/characters/*/*.png
assets/characters/*/*.jpg
!assets/characters/source/*.jpg
assets/gear/**/*.png
assets/gear/**/*.jpg

assets/props/**/*.import
assets/props/**/*.png
assets/props/**/*.jpg
assets/textures/**/*.import

# exported game builds (export_presets.cfg is tracked: it holds no passwords or keys)
build/
